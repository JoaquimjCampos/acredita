# Configurações do Sistema Acredita - Angola
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,acredita.ao

# Base de Dados
DATABASE_URL=postgresql://username:password@localhost:5432/acredita_db

# Configurações de Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@acredita.ao

# CORS e CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://acredita.ao
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://acredita.ao

# Celery (Tarefas Assíncronas)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# MCP (Model Context Protocol) - Configurações Centrais
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080
MCP_PROTOCOL_VERSION=2024-11-05
MCP_IMPLEMENTATION_NAME=acredita-mcp-server
MCP_IMPLEMENTATION_VERSION=1.0.0

# Configurações de Produção (Hostinger)
PRODUCTION_HOST=acredita.ao
STATIC_ROOT=/var/www/acredita/static/
MEDIA_ROOT=/var/www/acredita/media/
