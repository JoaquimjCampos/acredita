# Backend Environment Configuration Example
# Copy this file to .env and fill in your local values

SECRET_KEY=django-insecure-your-secret-key-here-min-50-chars-for-production
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Allowed hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,.local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Analytics
ANALYTICS_RATE_LIMIT_PER_MINUTE=120
ANALYTICS_KEY=your-strong-analytics-key-here-min-32-chars

# Optional: Logging
LOG_LEVEL=DEBUG
LOG_FILE_PATH=backend/logs/acredita.log
