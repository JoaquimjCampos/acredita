      "name": "Marketplace - ServiceListings",
      "item": [
        {
          "name": "GET Listings (All Roles)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
