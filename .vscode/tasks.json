{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Executar Servidor Django - Acredita",
			"type": "shell",
			"command": "D:/apps/Acredita/venv/Scripts/python.exe",
			"args": [
				"manage.py",
				"runserver"
			],
			"group": "build",
			"isBackground": true,
			"problemMatcher": [
				"$django"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new"
			},
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Run FastAPI server (Uvicorn)",
			"type": "shell",
			"command": "uvicorn backend.fastapi_app.main:app --reload --host 0.0.0.0 --port 8001",
			"group": "build"
		}
	]
}