# Frontend Environment Configuration Example
# Copy this file to .env.local and fill in your values
# For Create React App: uses REACT_APP_ prefix
# For Vite: uses VITE_ prefix (modify as needed)

# API Configuration
REACT_APP_API_BASE=http://localhost:8000
REACT_APP_ANALYTICS_KEY=your-strong-analytics-key-here

# Optional: Feature flags
REACT_APP_FEATURE_A_B_TESTING=true
REACT_APP_FEATURE_ACTIVITY_TIMELINE=true
REACT_APP_FEATURE_PERSONALIZATION=false

# Optional: Debugging
REACT_APP_DEBUG_ANALYTICS=false
REACT_APP_DEBUG_API_CALLS=false

# For Vite (if applicable):
# VITE_API_BASE=http://localhost:8000
# VITE_ANALYTICS_KEY=your-strong-analytics-key-here
